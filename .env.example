# Google Gemini API Key (Obtenha uma chave gratuita em https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token (PAT) com permissões de escrita no repositório
# Crie em https://github.com/settings/tokens (Fine-grained token com permissões em Contents e Pull Requests)
GITHUB_TOKEN=your_github_token_here

# Detalhes do Repositório GitHub (Exemplo)
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repository_name
GITHUB_BRANCH=main

# Token de Segurança do Vercel Cron (Configurado nas variáveis de ambiente do Vercel)
CRON_SECRET=your_random_cron_secret_phrase
